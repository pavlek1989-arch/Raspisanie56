# Файл с настройками. Скопируйте в .env и заполните свои значения.
# Никогда не коммитьте .env в репозиторий.

# --- Данные бота МАКС ---
# Получается через @MasterBot командой /create
MAX_TOKEN=ваш_токен_бота_здесь

# Секрет для webhook (вы придумываете его сами, он же указывается при создании подписки)
MAX_WEBHOOK_SECRET=придумайте_секрет

# Публичный HTTPS-адрес вашего сервера (куда MAX будет присылать события).
# Пример: https://schedule-bot.example.com/max/webhook
MAX_WEBHOOK_URL=

# --- Расписание (файл .xlsx) ---
# Публичная ссылка на файл расписания (Яндекс.Диск "Поделиться" или прямой URL .xlsx).
# Парсер сам получит прямую ссылку скачивания для disk.yandex.ru.
SCHEDULE_FILE_URL=https://disk.yandex.ru/i/-yedy5QwZvabPQ

# Часовой пояс школы (используется для определения "сегодня")
# Пример: Asia/Yekaterinburg, Europe/Moscow
TIMEZONE=Asia/Yekaterinburg